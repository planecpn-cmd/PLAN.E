# Edge Function secrets — set these with `supabase secrets set` (cloud) or
# `supabase functions serve --env-file supabase/functions/.env` (local docker).
# NEVER commit a filled-in .env — this is a template only.

# Khalti ePayment — use dev.khalti.com for sandbox and khalti.com for live.
# Get your own test-mode keys free at
# https://test-admin.khalti.com (Settings > Keys). Do not use production keys
# for local dev.
KHALTI_API_BASE_URL=https://dev.khalti.com/api/v2
KHALTI_SECRET_KEY=test_secret_key_replace_me
KHALTI_PUBLIC_KEY=test_public_key_replace_me

# eSewa ePay v2 sandbox — these are eSewa's own published test-merchant
# credentials (not secret, safe to commit). Swap for a live merchant
# code/secret only in production.
ESEWA_MERCHANT_CODE=EPAYTEST
ESEWA_SECRET_KEY=8gBm/:&EnhH.1/q

# Browser/WebView-facing base URL. Use the development Mac's current LAN IP so
# physical devices on the same Wi-Fi can reach payment callbacks without ADB.
PUBLIC_SUPABASE_URL=http://YOUR_MAC_LAN_IP:54341

# Auto-provided by the Supabase runtime — no need to set locally when using
# `supabase start` / `supabase functions serve`.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_ANON_KEY=
