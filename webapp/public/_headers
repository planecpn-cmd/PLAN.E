# https://developers.cloudflare.com/workers/static-assets/headers
# https://opennext.js.org/cloudflare/caching#static-assets-caching
/_next/static/*
  Cache-Control: public,max-age=31536000,immutable

# HERO-PERF: /brand/* filenames are stable, not content-hashed, so not
# immutable - but they change rarely enough to justify a week-long cache
# with revalidation, rather than the short/no-cache default Lighthouse
# flagged (991 KiB from short lifetimes).
/brand/*
  Cache-Control: public,max-age=604800,stale-while-revalidate=86400
